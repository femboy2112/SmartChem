__pycache__/
*.py[cod]
*.egg-info/
# Wheel/sdist build trees (this repo ships a pyproject; `pip wheel` / `build` create these).
build/
dist/
.venv/
venv/
.pytest_cache/
*.log
# Persistent species-energy caches. The energies in one are real and expensive, but a
# committed blob of them is a provenance claim this repo has not decided how to make:
# a cache record is only as trustworthy as the fingerprint it was keyed on.
experiments/*.json
experiments/*.json.lock
experiments/.probe_cache.json

# Local secrets / credentials — never commit these.
.env
.env.*
!.env.example
# OS / editor junk.
.DS_Store
*.swp
.idea/
# Coverage output produced locally.
.coverage
.coverage.*
htmlcov/
coverage.xml
