DATABASE llnl.dat
# mixed case M2 vinegar only (acetate limit): C_Ac=0.1 C_C=0.0 Na=0.0 mol/L (mol/kgw here; molar-match per PREREGISTRATION A1/A2 when run)
SOLUTION 1
  units mol/kgw
  temp 25
  pH 7 charge
  Acetate 0.1
SELECTED_OUTPUT
  -file llnl_M2.sel
  -reset false
  -ph true
  -ionic_strength true
  -totals C(4)
  -molalities H+ OH- Na+ Acetate- CO2 HCO3- CO3-2
  -activities H+ OH- Na+ Acetate-
END
