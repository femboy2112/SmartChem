DATABASE llnl.dat
# mixed case M9 high I near the Davies boundary: C_Ac=0.2 C_C=0.2 Na=0.4 mol/L (mol/kgw here; molar-match per PREREGISTRATION A1/A2 when run)
SOLUTION 1
  units mol/kgw
  temp 25
  pH 7 charge
  Na 0.4
  Acetate 0.2
  C(4) 0.2
SELECTED_OUTPUT
  -file llnl_M9.sel
  -reset false
  -ph true
  -ionic_strength true
  -totals C(4)
  -molalities H+ OH- Na+ Acetate- CO2 HCO3- CO3-2
  -activities H+ OH- Na+ Acetate-
END
