DATABASE minteq.v4.dat
# mixed case M6 bicarbonate in excess -> acid-limited: C_Ac=0.05 C_C=0.2 Na=0.2 mol/L (mol/kgw here; molar-match per PREREGISTRATION A1/A2 when run)
SOLUTION 1
  units mol/kgw
  temp 25
  pH 7 charge
  Na 0.2
  Acetate 0.05
  C(4) 0.2
SELECTED_OUTPUT
  -file minteq.v4_M6.sel
  -reset false
  -ph true
  -ionic_strength true
  -totals C(4)
  -molalities H+ OH- Na+ Acetate- CO2 HCO3- CO3-2
  -activities H+ OH- Na+ Acetate-
END
